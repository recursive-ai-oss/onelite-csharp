<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneLite.Bench</RootNamespace>
    <!-- LibraryImport (the raw P/Invoke of the reference library) is generated code that needs unsafe blocks; nothing hand-written here uses them. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bench-only: the comparison stacks. Neither is ever referenced from src/. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <ProjectReference Include="../../src/OneLite/OneLite.csproj" />
    <ProjectReference Include="../../src/OneLite.Data/OneLite.Data.csproj" />
  </ItemGroup>

</Project>
