# JSON functions, group 'extract'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select replace(json_extract('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$'), char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

query T nosort
select replace('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}' -> '$', char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

query T nosort
select replace('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}' ->> '$', char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

query T nosort
select replace(json_type('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$'), char(10), '~')
----
object

query I nosort
select json_array_length('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$')
----
0

