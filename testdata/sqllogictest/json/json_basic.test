# JSON functions, group 'basic'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select replace(json('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}'), char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

query I nosort
select json_valid('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')
----
1

query I nosort
select json_error_position('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')
----
0

query T nosort
select replace(json_type('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}'), char(10), '~')
----
object

query I nosort
select json_array_length('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')
----
0

query T nosort
select replace(json_pretty('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}'), char(10), '~')
----
{~    "a": 1,~    "b": [~        1,~        2,~        {~            "c": "x"~        }~    ],~    "d": null,~    "e": true,~    "f": 1.5~}

query T nosort
select replace(json_quote('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}'), char(10), '~')
----
"{\"a\":1,\"b\":[1,2,{\"c\":\"x\"}],\"d\":null,\"e\":true,\"f\":1.5}"

query T nosort
select replace(hex(jsonb('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')), char(10), '~')
----
CC1C1761133117629B133113324C17631778176400176501176635312E35

query T nosort
select replace(json(jsonb('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')), char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

