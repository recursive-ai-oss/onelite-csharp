# JSON functions, group 'tables'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
with q(x) as (select group_concat(coalesce(key,'N')||'|'||coalesce(typeof(value),'N')||'|'||coalesce(cast(value as text),'N')||'|'||type||'|'||coalesce(cast(atom as text),'N')||'|'||id||'|'||coalesce(parent,'N')||'|'||fullkey||'|'||path||'|'||rowid, ' ; ') from json_each('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}')) select replace(x, char(10), '~') from q
----
a|integer|1|integer|1|2|N|$.a|$|0 ; b|text|[1,2,{"c":"x"}]|array|N|6|N|$.b|$|1 ; d|null|N|null|N|18|N|$.d|$|2 ; e|integer|1|true|1|21|N|$.e|$|3 ; f|real|1.5|real|1.5|24|N|$.f|$|4

