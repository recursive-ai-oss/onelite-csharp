# JSON functions, group 'remove'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select json_remove('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$')
----
NULL

query T nosort
select replace(hex(jsonb_remove('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$')), char(10), '~')
----
(empty)

query T nosort
select replace(json_remove('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '$.a'), char(10), '~')
----
{"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

