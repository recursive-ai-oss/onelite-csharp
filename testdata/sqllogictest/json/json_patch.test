# JSON functions, group 'patch'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}'), char(10), '~')
----
{"a":1,"b":[1,2,{"c":"x"}],"e":true,"f":1.5}

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '[1,2,3,[4,5],{"k":"v"}]'), char(10), '~')
----
[1,2,3,[4,5],{"k":"v"}]

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '  {"a" : [ 1 , 2 ] , "b" : "s\u00e9\n" }  '), char(10), '~')
----
{"a":[1,2],"b":"s\u00e9\n","d":null,"e":true,"f":1.5}

statement error
select json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '{a:1,\'b\':0x10,c:[+1,.5,5.,Infinity,-Infinity,NaN,],}')

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '{"a":{"b":{"c":{"d":[[[]]]}}}}'), char(10), '~')
----
{"a":{"b":{"c":{"d":[[[]]]}}},"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '"text"'), char(10), '~')
----
"text"

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '12345678901234567890'), char(10), '~')
----
12345678901234567890

query T nosort
select replace(json_patch('{"a":1,"b":[1,2,{"c":"x"}],"d":null,"e":true,"f":1.5}', '-0'), char(10), '~')
----
-0

