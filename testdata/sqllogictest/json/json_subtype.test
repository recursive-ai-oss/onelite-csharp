# JSON functions, group 'subtype'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select replace(json('[1]') || 'x', char(10), '~')
----
[1]x

query T nosort
select replace(json_array(json('[1]') || ''), char(10), '~')
----
["[1]"]

query T nosort
select replace(json_extract('[[1]]', '$[0]'), char(10), '~')
----
[1]

query T nosort
select replace(json_array(json_extract('[[1]]', '$[0]')), char(10), '~')
----
[[1]]

query T nosort
select replace(json_array('[1]'->'$'), char(10), '~')
----
[[1]]

query T nosort
select replace(json_array('{"a":[1]}'->>'$.a'), char(10), '~')
----
["[1]"]

query TTT nosort
select typeof('[1]'->'$'), typeof('[1]'->>'$[0]'), typeof('{"a":"x"}'->>'a')
----
text
integer
text

query TT nosort
select json_object('a', 1) -> 'a', json_object('a', 'x') ->> 'a'
----
1
x

query I nosort
select '{"a":2}' -> '$.a' + 1
----
3

query T nosort
select replace('{"a":{"b":3}}' -> 'a' -> 'b', char(10), '~')
----
3

query TT nosort
select '{"a":1}' -> null, null -> '$'
----
NULL
NULL

query III nosort
select json_valid(x'7b7d'), json_valid(jsonb('{}')), json_valid(x'00')
----
1
0
0

query TT nosort
select typeof(jsonb('[1]')), typeof(json('[1]'))
----
blob
text

query T nosort
select replace(hex(jsonb('[1,2,{"a":"b"}]')), char(10), '~')
----
9B133113324C17611762

query T nosort
select replace(json(jsonb('{"a":[1,2.5,"x",null,true]}')), char(10), '~')
----
{"a":[1,2.5,"x",null,true]}

query T nosort
select replace(json_pretty('{"a":[1,2,{"b":[]}],"c":{}}'), char(10), '~')
----
{~    "a": [~        1,~        2,~        {~            "b": []~        }~    ],~    "c": {}~}

query T nosort
select replace(json_pretty('[1,[2,3]]', '  '), char(10), '~')
----
[~  1,~  [~    2,~    3~  ]~]

query T nosort
select replace(json_pretty('[1,[2,3]]', null), char(10), '~')
----
[~    1,~    [~        2,~        3~    ]~]
