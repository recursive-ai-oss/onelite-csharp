# JSON functions, group 'numbers'. Expected results are the output of sqlite 3.53.4 (the pinned shell).

query T nosort
select replace(json('[9223372036854775807]'), char(10), '~')
----
[9223372036854775807]

query I nosort
select json_extract('[9223372036854775807]', '$[0]')
----
9223372036854775807

query T nosort
select replace(json_type('[9223372036854775807]', '$[0]'), char(10), '~')
----
integer

query IT nosort
select '[9223372036854775807]' ->> 0, '[9223372036854775807]' -> 0
----
9223372036854775807
9223372036854775807

query T nosort
select replace(json_array(9223372036854775807), char(10), '~')
----
[9223372036854775807]

query T nosort
select replace(hex(jsonb('[9223372036854775807]')), char(10), '~')
----
CB15C31339323233333732303336383534373735383037

query T nosort
select replace(json('[9223372036854775808]'), char(10), '~')
