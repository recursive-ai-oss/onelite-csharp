<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onelite</ToolCommandName>
    <!-- A tool is not a library: no API surface to validate, and it is not published trimmed. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsTrimmable>false</IsTrimmable>
    <Description>The onelite command-line tool for OneLite, a pure-managed SQLite-compatible database: open, query, dump, import and recover database files. $(PackageDescriptionNotice)</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneLite.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneLite/OneLite.csproj" />
  </ItemGroup>

</Project>
